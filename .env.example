HABITICA_USER_ID=
HABITICA_API_TOKEN=

# Jarvis API guard (single-user API key, Phase 6)
JARVIS_API_KEY=

# SQLite database file (defaults to ./data/mission-control.db)
# DATABASE_URL=./data/mission-control.db
