# Command Center Environment Variables

# ── Database ──────────────────────────────────────────────────
# Path to SQLite database file (default: ./data/mission-control.db)
# DATABASE_URL=./data/mission-control.db

# ── API Authentication ────────────────────────────────────────
# Secret token for API access. When set, all /api/* requests must
# include: Authorization: Bearer <API_SECRET>
#
# When NOT set, API routes are restricted to localhost only (127.0.0.1 / ::1).
# Set this to allow remote API access (e.g., from Hermes, cron jobs, git hooks).
#
# Generate a secure token: openssl rand -hex 32
# API_SECRET=your-secret-token-here

# ── Habitica Integration ──────────────────────────────────────
# Credentials for syncing with Habitica. Can also be set via the
# Settings dialog in the UI (stored encrypted in the database).
#
# HABITICA_USER_ID=your-user-id
# HABITICA_API_TOKEN=your-api-token
